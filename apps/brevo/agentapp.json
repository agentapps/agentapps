{
  "id": "app.brevo",
  "name": "Brevo",
  "version": "2.0.1",
  "description": "Brevo email marketing — send transactional emails, manage contacts and lists, create email templates, and browse email campaigns through the Brevo API.",
  "tagline": "Send emails, manage contacts, lists, templates, and campaigns in Brevo",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "communication",
  "keywords": [
    "brevo",
    "sendinblue",
    "email",
    "email-marketing",
    "transactional-email",
    "contacts",
    "campaigns"
  ],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": { "type": "api-key", "installationSecrets": ["BREVO_API_KEY"] }
}
