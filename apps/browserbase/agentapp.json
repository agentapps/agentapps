{
  "id": "app.browserbase",
  "name": "Browserbase",
  "version": "2.0.1",
  "description": "Cloud browser automation at scale. Anti-bot bypass, CAPTCHA solving, residential proxies, session recording, and parallel browsers. Includes Live View to watch the browser in real time.",
  "tagline": "Cloud browser automation with stealth, CAPTCHA solving, and Live View",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "development",
  "keywords": [
    "browser",
    "browserbase",
    "automation",
    "scraping",
    "headless",
    "cloud",
    "stealth",
    "captcha"
  ],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": {
    "type": "api-key",
    "installationSecrets": ["BROWSERBASE_API_KEY", "BROWSERBASE_PROJECT_ID"]
  }
}
