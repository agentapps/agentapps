{
  "id": "app.calendly",
  "version": "2.0.0",
  "name": "Calendly",
  "description": "Calendly scheduling — manage event types, scheduled events, invitees, and availability.",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "scheduling",
  "keywords": ["calendly", "scheduling", "calendar", "meetings", "appointments"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": { "tools": true, "health": true },

  "auth": {
    "type": "api-key",
    "installationSecrets": ["ACCESS_TOKEN"]
  }
}
