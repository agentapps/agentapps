{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.context7",
  "version": "2.0.0",
  "name": "Context7",
  "description": "Up-to-date library and framework documentation via Context7 (Upstash). Resolves library identifiers and fetches structured doc snippets with code examples.",
  "tagline": "Up-to-date library docs with real code examples",
  "author": { "name": "Pablo Lopez Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "icon": "icon.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "development",
  "keywords": ["docs", "documentation", "context7", "upstash", "library", "research", "snippets"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "events": false,
    "health": true,
    "streaming": false,
    "auth": false,
    "storage": false,
    "intents": false
  },

  "auth": {
    "type": "api-key",
    "installationSecrets": ["CONTEXT7_API_KEY"]
  },

  "installation": {
    "singleton": false,
    "requiresUserConsent": false
  }
}
