{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.factorial",
  "version": "2.0.3",
  "name": "Factorial",
  "description": "Factorial HR — manage employees, time off, attendance, payroll, documents, contracts and teams via Factorial API with OAuth2",
  "tagline": "Manage employees, time off, attendance, and payroll in Factorial HR",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "productivity",
  "keywords": [
    "factorial",
    "hr",
    "employees",
    "payroll",
    "time-off",
    "attendance",
    "contracts",
    "documents"
  ],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": { "tools": true, "health": true },

  "auth": {
    "type": "oauth2",
    "provider": "factorial",
    "authorizeUrl": "https://api.factorialhr.com/oauth/authorize",
    "tokenUrl": "https://api.factorialhr.com/oauth/token",
    "scopes": [
      "employees",
      "time_off",
      "time_tracking",
      "documents",
      "contracts",
      "company_locations",
      "company_legal_entities"
    ],
    "pkce": false,
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "TOKEN_TYPE", "USER_ID", "USER_EMAIL"]
  }
}
