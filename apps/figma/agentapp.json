{
  "id": "app.figma",
  "name": "Figma",
  "version": "2.0.0",
  "description": "Access Figma design files, extract styles, components, design tokens, and export assets. Works directly with files via file key. Perfect for design-to-code workflows.",
  "tagline": "Inspect Figma files, extract design tokens, and export assets",
  "author": { "name": "Pablo Lopez Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "design",
  "keywords": ["figma", "design", "ui", "ux", "styles", "components", "tokens", "css", "tailwind"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": { "tools": true, "health": true },

  "auth": {
    "type": "oauth2",
    "provider": "figma",
    "authorizeUrl": "https://www.figma.com/oauth",
    "tokenUrl": "https://api.figma.com/v1/oauth/token",
    "scopes": [
      "current_user:read",
      "file_content:read",
      "file_metadata:read",
      "file_comments:read",
      "file_comments:write",
      "file_versions:read",
      "library_assets:read",
      "library_content:read",
      "team_library_content:read",
      "file_dev_resources:read",
      "file_dev_resources:write",
      "file_variables:read",
      "webhooks:read",
      "webhooks:write"
    ],
    "pkce": false,
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "EXPIRY_DATE"]
  }
}
