{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.filesystem",
  "version": "2.0.1",
  "name": "Filesystem",
  "description": "Filesystem operations: read, write, edit, patch, search (glob/grep), list, tree, stat, hash, copy, move, delete, and mkdir. Path-traversal safe, shell-injection safe, gitignore aware.",
  "tagline": "Safe file operations with read, write, search, and more",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "icon": "icon.svg",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "development",
  "keywords": ["files", "filesystem", "read", "write", "edit", "search", "grep", "glob"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "events": false,
    "health": true,
    "streaming": false,
    "auth": false,
    "storage": false,
    "intents": false
  },

  "auth": {
    "type": "none",
    "systemSecrets": []
  },

  "installation": {
    "singleton": false,
    "requiresUserConsent": false
  }
}
