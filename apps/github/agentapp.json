{
  "id": "app.github",
  "name": "GitHub",
  "version": "2.0.2",
  "description": "GitHub repository management + local git development environment - repos, issues, pull requests, actions, commits, branches, releases, plus local git operations on cloned repos",
  "tagline": "Manage repos, issues, PRs, and actions on GitHub",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "development",
  "keywords": ["github", "git", "repositories", "issues", "pull-requests", "ci-cd", "actions"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": { "tools": true, "health": true },

  "auth": {
    "type": "github-app",
    "provider": "github",
    "appSlug": "agentapps",
    "setupUrl": "https://github.com/apps/agentapps/installations/new",
    "userOAuth": true,
    "tokenUrl": "https://github.com/login/oauth/access_token",
    "permissions": {
      "contents": "write",
      "issues": "write",
      "pull_requests": "write",
      "metadata": "read",
      "workflows": "write",
      "actions": "write",
      "checks": "write",
      "members": "read",
      "administration": "read"
    },
    "events": ["installation", "push", "pull_request", "issues"],
    "systemSecrets": [
      "GITHUB_APP_ID",
      "GITHUB_APP_CLIENT_ID",
      "GITHUB_APP_CLIENT_SECRET",
      "GITHUB_APP_PRIVATE_KEY",
      "GITHUB_APP_WEBHOOK_SECRET",
      "GITHUB_APP_SLUG"
    ],
    "installationSecrets": [
      "INSTALLATION_ID",
      "USER_ACCESS_TOKEN",
      "USER_REFRESH_TOKEN",
      "USER_TOKEN_EXPIRES_AT",
      "USER_LOGIN"
    ]
  }
}
