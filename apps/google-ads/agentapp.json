{
  "id": "app.google.ads",
  "name": "Google Ads",
  "version": "1.0.0",
  "description": "Google Ads API (REST, v26): list the accounts a Google user can reach (including through manager accounts), report on account, campaign, ad group, ad, keyword and search term performance, run read-only GAQL queries, pause or enable campaigns and ad groups, change campaign budgets and add negative keywords. Writes that can spend money are marked destructive.",
  "tagline": "Report on Google Ads performance and manage campaigns, budgets and negative keywords",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "google",
  "keywords": [
    "google",
    "google-ads",
    "adwords",
    "ads",
    "ppc",
    "sem",
    "marketing",
    "advertising",
    "campaigns",
    "gaql"
  ],
  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },
  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },
  "capabilities": {
    "tools": true,
    "health": true
  },
  "auth": {
    "type": "oauth2",
    "provider": "google",
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET", "REDIRECT_URI", "DEVELOPER_TOKEN"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "EMAIL", "EXPIRY_DATE"],
    "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/adwords",
      "https://www.googleapis.com/auth/userinfo.email"
    ],
    "pkce": false
  }
}
