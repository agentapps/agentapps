{
  "id": "app.google.analytics",
  "name": "Google Analytics",
  "version": "2.0.0",
  "description": "Google Analytics 4 (GA4) — run reports, query realtime data, and manage properties and data streams",
  "tagline": "Run GA4 reports, query realtime data, and manage properties and data streams",
  "author": { "name": "Pablo Lopez Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "terms": "https://agentapps.tech/terms",
  "category": "google",
  "keywords": [
    "google",
    "analytics",
    "ga4",
    "reports",
    "metrics",
    "dimensions",
    "events",
    "realtime"
  ],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": {
    "type": "oauth2",
    "provider": "google",
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET", "REDIRECT_URI"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "EMAIL", "EXPIRY_DATE"],
    "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/analytics.readonly",
      "https://www.googleapis.com/auth/analytics.edit",
      "https://www.googleapis.com/auth/userinfo.email"
    ],
    "pkce": false
  }
}
