{
  "id": "app.google.docs",
  "name": "Google Docs",
  "version": "2.1.0",
  "description": "Create, read, and edit Google Docs documents - create, read content, insert text, append text, delete content, insert tables, insert images, find & replace, text styling, named ranges, batch updates. To delete a document, use the Google Drive app.",
  "tagline": "Create, read, and edit Google Docs documents",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "google",
  "keywords": ["google", "docs", "documents", "write", "edit", "create"],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": {
    "type": "oauth2",
    "provider": "google",
    "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/documents",
      "https://www.googleapis.com/auth/documents.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ],
    "pkce": false,
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN"]
  }
}
