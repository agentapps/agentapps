{
  "id": "app.google.gmail",
  "name": "Gmail",
  "version": "2.1.0",
  "description": "Gmail email management — send, read, search, label, and filter emails via Google Gmail API.",
  "tagline": "Send, read, search, and manage emails in Gmail",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "google",
  "keywords": ["gmail", "email", "google", "mail", "messages"],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": {
    "type": "oauth2",
    "provider": "google",
    "setup": "To configure Gmail:\n  1. In the Google Cloud console (https://console.cloud.google.com/apis/credentials), create or pick a project and enable the Gmail API.\n  2. Create an OAuth client ID of type Web application.\n  3. Add this redirect URI to the client: {{redirectUri}}\n  4. Copy the client ID and the client secret.",
    "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/userinfo.email"
    ],
    "pkce": false,
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "EMAIL", "EXPIRY_DATE"]
  }
}
