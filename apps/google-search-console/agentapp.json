{
  "id": "app.google.search-console",
  "name": "Google Search Console",
  "version": "1.0.0",
  "description": "Google Search Console: query search performance (clicks, impressions, CTR, position by query, page, country, device, date), compare periods, inspect URL index status, and manage sitemaps and properties through the Search Console API.",
  "tagline": "SEO performance, URL inspection and sitemaps from Google Search Console",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "google",
  "keywords": [
    "google",
    "search-console",
    "seo",
    "search-analytics",
    "sitemaps",
    "url-inspection",
    "indexing",
    "webmasters"
  ],
  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },
  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },
  "capabilities": {
    "tools": true,
    "health": true
  },
  "auth": {
    "type": "oauth2",
    "provider": "google",
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET", "REDIRECT_URI"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "EXPIRY_DATE"],
    "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/webmasters",
      "https://www.googleapis.com/auth/userinfo.email"
    ],
    "pkce": false
  }
}
