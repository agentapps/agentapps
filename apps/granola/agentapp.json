{
  "id": "app.granola",
  "version": "2.0.3",
  "name": "Granola",
  "description": "Access your Granola meeting notes, transcripts, AI summaries, and folders via the Granola public API.",
  "tagline": "Browse meeting notes, transcripts, and AI summaries from Granola",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "icon": "icon.svg",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "productivity",
  "keywords": ["granola", "meeting-notes", "transcripts", "ai-summary", "productivity"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "events": false,
    "health": true,
    "streaming": false,
    "auth": false,
    "storage": false,
    "intents": false
  },

  "auth": {
    "type": "api-key",
    "installationSecrets": ["API_KEY"]
  },

  "installation": {
    "singleton": false,
    "requiresUserConsent": false
  }
}
