{
  "id": "app.higgsfield",
  "name": "Higgsfield",
  "version": "3.0.1",
  "description": "Generate AI images and videos with Higgsfield - text-to-image, image-to-video, and consistent character generation with Soul.",
  "tagline": "AI image and video generation with text-to-image, image-to-video, and Soul characters",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.png",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "ai",
  "keywords": [
    "higgsfield",
    "ai",
    "image-generation",
    "video-generation",
    "text-to-image",
    "image-to-video",
    "soul",
    "character"
  ],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": { "type": "api-key", "installationSecrets": ["API_KEY", "API_SECRET"] }
}
