{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.holded",
  "version": "2.0.2",
  "name": "Holded",
  "description": "Holded ERP — manage invoices, contacts, products, documents, and treasury via the Holded API.",
  "tagline": "Manage invoices, contacts, and accounting with Holded ERP",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "terms": "https://agentapps.tech/terms",
  "category": "finance",
  "keywords": ["holded", "erp", "invoices", "accounting", "spain"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "health": true
  },

  "auth": {
    "type": "api-key",
    "systemSecrets": ["API_KEY"]
  }
}
