{
  "id": "app.homey",
  "name": "Homey",
  "version": "3.0.0",
  "description": "Homey smart home controller — control devices, manage flows, and monitor your home via Athom Cloud API.",
  "tagline": "Control devices, run automations, and monitor energy on your Homey smart home hub",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "other",
  "keywords": ["homey", "home-automation", "iot", "devices", "flows", "athom"],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": {
    "type": "oauth2",
    "provider": "homey",
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "TOKEN_TYPE", "EXPIRES_IN"],
    "authorizeUrl": "https://api.athom.com/oauth2/authorise",
    "tokenUrl": "https://api.athom.com/oauth2/token",
    "scopes": [
      "account.homeys",
      "homey.app.readonly",
      "homey.device.readonly",
      "homey.device.control",
      "homey.energy.readonly",
      "homey.flow.readonly",
      "homey.flow.start",
      "homey.insights.readonly",
      "homey.logic",
      "homey.logic.readonly",
      "homey.notifications.readonly",
      "homey.presence.readonly",
      "homey.presence.self",
      "homey.user.readonly",
      "homey.user.self",
      "homey.zone.readonly"
    ],
    "scopeSeparator": ",",
    "pkce": false
  }
}
