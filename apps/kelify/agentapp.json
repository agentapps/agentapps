{
  "id": "app.kelify",
  "name": "Kelify AI Property Search",
  "version": "2.0.0",
  "description": "AI-powered conversational property search API for real estate listings",
  "tagline": "Search real estate listings through AI-powered conversations",
  "author": { "name": "Kelify", "email": "contact@kelify.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "ai",
  "keywords": ["real estate", "property search", "ai", "conversational", "kelify"],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": { "type": "api-key", "systemSecrets": ["KELIFY_API_KEY"] }
}
