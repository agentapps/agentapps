{
  "id": "app.linear",
  "name": "Linear",
  "version": "2.0.0",
  "description": "Linear issue tracking - list, create, update issues, manage projects, labels, teams and users",
  "tagline": "Manage issues, projects, and labels in Linear",
  "author": { "name": "Pablo Lopez Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "productivity",
  "keywords": ["linear", "issues", "tasks", "project-management"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": { "tools": true, "health": true },

  "auth": {
    "type": "api-key",
    "installationSecrets": ["API_KEY"]
  }
}
