{
  "id": "app.minio",
  "name": "MinIO",
  "version": "2.0.1",
  "description": "MinIO S3-compatible object storage — manage buckets, upload/download objects, generate presigned URLs.",
  "tagline": "Manage buckets, objects, and presigned URLs in MinIO S3-compatible storage",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "storage",
  "keywords": ["minio", "s3", "storage", "objects", "buckets", "files", "backup"],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": { "type": "api-key", "systemSecrets": ["ENDPOINT", "ACCESS_KEY", "SECRET_KEY"] }
}
