{
  "id": "app.odoo",
  "name": "Odoo",
  "version": "2.0.1",
  "description": "Odoo ERP integration — manage partners, products, sales orders, invoices, projects, tasks, employees, leaves and timesheets via the Odoo JSON-RPC API using an API key.",
  "tagline": "Manage partners, sales, projects, HR and more in Odoo ERP",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "productivity",
  "keywords": [
    "odoo",
    "erp",
    "crm",
    "sales",
    "invoicing",
    "project",
    "hr",
    "employees",
    "timesheet",
    "inventory"
  ],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": { "type": "api-key", "installationSecrets": ["BASE_URL", "DATABASE", "API_KEY"] }
}
