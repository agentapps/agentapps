{
  "name": "@agentapps/app.playwright",
  "version": "1.0.0",
  "private": true,
  "agentapps": {
    "publish": false
  },
  "description": "Playwright browser automation agent app — navigate, interact, take screenshots, and extract data from web pages.",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "postinstall": "node -e \"process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD || require('node:child_process').execSync('npx playwright install chromium', { stdio: 'inherit' })\"",
    "dev": "tsx src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentapps/sdk": "workspace:*",
    "playwright": "1.65.0"
  },
  "devDependencies": {
    "@agentapps/station": "workspace:*",
    "@agentapps/protocol": "workspace:*",
    "tsx": "^4.19.4",
    "vitest": "^3.2.0"
  }
}
