{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.posthog",
  "version": "3.0.0",
  "name": "PostHog",
  "description": "PostHog product analytics — events, persons, feature flags, insights, cohorts, and annotations.",
  "tagline": "Product analytics, feature flags, and insights with PostHog",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "analytics",
  "keywords": ["posthog", "analytics", "events", "feature-flags", "insights"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "health": true
  },

  "auth": {
    "type": "api-key",
    "systemSecrets": ["API_KEY", "PROJECT_ID"],
    "installationSecrets": []
  }
}
