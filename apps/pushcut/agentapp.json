{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.pushcut",
  "version": "1.0.0",
  "name": "Pushcut",
  "description": "Send smart notifications, execute Shortcuts and HomeKit scenes on your iOS devices via the Pushcut API.",
  "tagline": "Smart notifications, Shortcuts, and HomeKit for iOS",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "icon": "icon.svg",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "automation",
  "keywords": ["pushcut", "notifications", "shortcuts", "homekit", "ios", "automation"],
  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },
  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },
  "capabilities": {
    "tools": true,
    "events": false,
    "health": true,
    "streaming": false,
    "auth": false,
    "storage": false,
    "intents": false
  },
  "auth": {
    "type": "api-key",
    "installationSecrets": ["API_KEY"]
  },
  "installation": {
    "singleton": false,
    "requiresUserConsent": false
  }
}
