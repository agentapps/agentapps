{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.replicate",
  "version": "1.0.1",
  "name": "Replicate",
  "description": "Run any AI model on Replicate. Discover models, start async predictions, poll for results, and manage running jobs.",
  "tagline": "Run any AI model with async predictions and job management",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "icon": "icon.svg",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "ai",
  "keywords": ["replicate", "ai", "models", "predictions", "image-generation", "video-generation"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "events": false,
    "health": true,
    "streaming": false,
    "auth": false,
    "storage": false,
    "intents": false
  },

  "auth": {
    "type": "api-key",
    "systemSecrets": ["API_TOKEN"]
  },

  "installation": {
    "singleton": false,
    "requiresUserConsent": false
  }
}
