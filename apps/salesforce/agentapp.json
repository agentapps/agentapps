{
  "id": "app.salesforce",
  "version": "2.0.0",
  "name": "Salesforce",
  "description": "Salesforce CRM — manage accounts, contacts, opportunities, leads, cases, and run SOQL queries.",
  "author": { "name": "Pablo Lopez Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "crm",
  "keywords": ["salesforce", "crm", "sales", "leads", "opportunities"],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": {
    "type": "oauth2",
    "provider": "salesforce",
    "authorizeUrl": "https://login.salesforce.com/services/oauth2/authorize",
    "tokenUrl": "https://login.salesforce.com/services/oauth2/token",
    "scopes": ["api", "refresh_token"],
    "pkce": false,
    "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET", "REDIRECT_URI"],
    "installationSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "INSTANCE_URL"]
  }
}
