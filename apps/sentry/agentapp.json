{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.sentry",
  "version": "2.0.1",
  "name": "Sentry",
  "description": "Monitor errors and issues in your applications via the Sentry API.",
  "tagline": "Track and monitor application errors and issues",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "icon": "icon.svg",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "devops",
  "keywords": ["sentry", "errors", "monitoring", "issues", "debugging"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "events": false,
    "health": true,
    "streaming": false,
    "auth": false,
    "storage": false,
    "intents": false
  },

  "auth": {
    "type": "api-key",
    "systemSecrets": ["API_KEY", "ORGANIZATION"]
  },

  "installation": {
    "singleton": false,
    "requiresUserConsent": false
  }
}
