{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.supabase",
  "version": "3.0.1",
  "name": "Supabase",
  "description": "Supabase database and storage — query tables, manage rows, run SQL, list buckets, and upload/download files.",
  "tagline": "Query databases and manage storage with Supabase",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "database",
  "keywords": ["supabase", "database", "postgres", "storage", "sql"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "health": true
  },

  "auth": {
    "type": "api-key",
    "systemSecrets": ["SUPABASE_URL", "SUPABASE_KEY"]
  }
}
