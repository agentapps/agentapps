{
  "id": "app.trello",
  "name": "Trello",
  "version": "2.0.0",
  "description": "Trello project management — manage boards, lists, cards, labels, and search across your Trello workspace.",
  "tagline": "Manage boards, lists, cards, and labels in Trello",
  "author": { "name": "Pablo Lopez Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "productivity",
  "keywords": ["trello", "boards", "cards", "project-management", "kanban"],
  "entrypoint": { "type": "module", "path": "src/app.ts", "export": "factory" },
  "runtime": { "transport": "stdio", "command": "tsx", "args": ["src/app.ts"] },
  "capabilities": { "tools": true, "health": true },
  "auth": {
    "type": "api-key",
    "systemSecrets": ["TRELLO_API_KEY"],
    "installationSecrets": ["TRELLO_TOKEN"]
  }
}
