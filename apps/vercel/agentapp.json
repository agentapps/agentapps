{
  "$schema": "https://agentapps.dev/schemas/app-manifest.json",
  "id": "app.vercel",
  "version": "3.0.1",
  "name": "Vercel",
  "description": "Vercel platform management — manage projects, deployments, domains, environment variables, and check deployment logs.",
  "tagline": "Manage projects and deployments on Vercel",
  "author": { "name": "Pablo López Torres", "email": "pablolopeztorres@gmail.com" },
  "license": "MIT",
  "logo": "assets/logo.svg",
  "logoMono": "assets/logo-mono.svg",
  "terms": "https://agentapps.tech/terms",
  "category": "development",
  "keywords": ["vercel", "deploy", "hosting", "serverless", "nextjs"],

  "entrypoint": {
    "type": "module",
    "path": "src/app.ts",
    "export": "factory"
  },

  "runtime": {
    "transport": "stdio",
    "command": "tsx",
    "args": ["src/app.ts"]
  },

  "capabilities": {
    "tools": true,
    "health": true
  },

  "auth": {
    "type": "api-key",
    "installationSecrets": ["API_TOKEN"]
  }
}
