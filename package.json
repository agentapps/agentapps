{
  "name": "agentapps",
  "private": true,
  "description": "Agent Apps — open SDK, controller and protocol for building apps that plug into agent platforms",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "author": "Pablo Lopez Torres <pablolopeztorres@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentapps/agentapps.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "pretest": "pnpm --filter @agentapps/station build:fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "docs": "pnpm build && typedoc",
    "release": "pnpm build && changeset publish",
    "agentapps": "agentapps",
    "aa": "agentapps"
  },
  "devDependencies": {
    "@agentapps/app.hello": "workspace:*",
    "@agentapps/cli": "workspace:*",
    "@biomejs/biome": "^2.3.0",
    "@changesets/cli": "^2.29.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.2.0",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
