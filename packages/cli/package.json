{
  "name": "@agentapps/cli",
  "version": "0.3.0",
  "description": "Agent Apps CLI — run and exercise Agent Apps locally from a workspace",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentapps": "./dist/bin.js",
    "cli": "./dist/bin.js",
    "agentapps-daemon": "./dist/daemon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-catalog.mjs",
    "test": "vitest run --root ../.."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentapps/agentapps.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "agentapps",
    "cli",
    "mcp",
    "agent",
    "ai",
    "repl"
  ],
  "author": "Pablo López Torres <pablolopeztorres@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentapps/host": "workspace:*",
    "@agentapps/protocol": "workspace:*",
    "@agentapps/station": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependencies": {
    "tsx": "^4.19.4"
  },
  "peerDependenciesMeta": {
    "tsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentapps/sdk": "workspace:*",
    "tsx": "^4.19.4"
  }
}
