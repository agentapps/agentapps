{
  "name": "@agentapps/create",
  "version": "0.2.4",
  "description": "Scaffold an Agent App (npm create @agentapps) in the current conventions — templates, validation, health check, dev mode, packaging",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create": "./dist/cli.js",
    "create-agent-app": "./dist/cli.js",
    "agentapps-check-app": "./dist/bin/check-app.js",
    "agentapps-validate": "./dist/bin/check-app.js",
    "agentapps-pack": "./dist/bin/pack.js"
  },
  "files": [
    "dist",
    "templates",
    "skill"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentapps/agentapps.git",
    "directory": "packages/create"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "agentapps",
    "create",
    "scaffold",
    "mcp",
    "agent",
    "ai",
    "template"
  ],
  "author": "Pablo López Torres <pablolopeztorres@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentapps/sdk": "workspace:*",
    "@agentapps/station": "workspace:*",
    "@agentapps/protocol": "workspace:*",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
