describe('system secrets', () => {
  it('names the config command on the app id when one is missing, before any request', async () => {
    for (const key of Object.keys(systemSecrets)) delete systemSecrets[key];
    const fetchMock = mockFetch();
    const result = await callTool('get-example', { id: 1 });
    expect(result.success).toBe(false);
    expect(JSON.stringify(result.error)).toContain('agentapps config {{APP_ID}}');
    expect(fetchMock).not.toHaveBeenCalled();
  });
});
