describe('oauth', () => {
  it('asks to connect the account when no access token is stored, before any request', async () => {
    delete installationSecrets.ACCESS_TOKEN;
    const fetchMock = mockFetch();
    const result = await callTool('get-example', { id: 1 });
    expect(result.success).toBe(false);
    expect(JSON.stringify(result.error)).toContain('AUTH_REQUIRED');
    expect(JSON.stringify(result.error)).toContain('auth');
    expect(fetchMock).not.toHaveBeenCalled();
  });

  it('refreshes once through the host on 401 and replays with the new token', async () => {
    const fetchMock = mockFetch(
      jsonResponse({ error: 'expired' }, 401),
      jsonResponse({ id: 7, name: 'Fresh' }),
    );
    const result = await callTool('get-example', { id: 7 });
    expect(result.success).toBe(true);
    expect(refresh.calls).toBe(1);
    const header = (n: number) =>
      (requestOf(fetchMock, n).init.headers as Record<string, string>).Authorization;
    expect(header(0)).toBe('Bearer fake-access-token');
    expect(header(1)).toBe('Bearer fake-refreshed-access-token');
  });

  it('stops after one refresh when the new token is rejected too', async () => {
    const fetchMock = mockFetch(jsonResponse({}, 401), jsonResponse({}, 401));
    const result = await callTool('get-example', { id: 7 });
    expect(result.success).toBe(false);
    expect(JSON.stringify(result.error)).toContain('AUTH_EXPIRED');
    expect(refresh.calls).toBe(1);
    expect(fetchMock).toHaveBeenCalledTimes(2);
  });

  it('asks to reconnect when the refresh token is dead', async () => {
    refresh.next = null;
    mockFetch(jsonResponse({}, 401));
    const result = await callTool('get-example', { id: 7 });
    expect(result.success).toBe(false);
    const message = JSON.stringify(result.error);
    expect(message).toContain('AUTH_EXPIRED');
    expect(message).toContain('auth reauth');
  });

  it('names the config command when the OAuth client is not configured', async () => {
    refresh.next = null;
    delete systemSecrets.CLIENT_SECRET;
    mockFetch(jsonResponse({}, 401));
    const result = await callTool('get-example', { id: 7 });
    expect(result.success).toBe(false);
    const message = JSON.stringify(result.error);
    expect(message).toContain('SYSTEM_CONFIG_MISSING');
    expect(message).toContain('agentapps config {{APP_ID}}');
  });
});
{{/OAUTH}}
