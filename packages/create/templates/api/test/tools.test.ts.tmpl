describe('get-example', () => {
  // TODO: replace with tests for the real tools.
  it('requests the item and returns a curated shape', async () => {
    const fetchMock = mockFetch(jsonResponse({ id: 42, name: 'Example', noise: 'dropped' }));
    const result = await callTool('get-example', { id: 42 });
    expect(result.success).toBe(true);
    expect(result.result).toEqual({ id: '42', name: 'Example' });
    const { url, init } = requestOf(fetchMock);
    expect(url.pathname).toMatch(/\/example\/42$/);
    expect(init.method).toBe('GET');
  });

  it('rejects an id that would change the URL path, before any request', async () => {
    const fetchMock = mockFetch();
    const result = await callTool('get-example', { id: '../admin' });
    expect(result.success).toBe(false);
    expect(fetchMock).not.toHaveBeenCalled();
  });

  it('surfaces API errors with the status', async () => {
    mockFetch(jsonResponse({ error: 'not found' }, 404));
    const result = await callTool('get-example', { id: 'missing' });
    expect(result.success).toBe(false);
    expect(JSON.stringify(result.error)).toContain('404');
  });
});
