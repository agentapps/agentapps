{
  "name": "@agentapps/testing",
  "version": "0.2.4",
  "description": "Test harness for Agent App developers: run apps in-process and assert on protocol traffic",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentapps/agentapps.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "agentapps",
    "testing",
    "mcp",
    "agent",
    "ai",
    "test-harness"
  ],
  "author": "Pablo López Torres <pablolopeztorres@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentapps/station": "workspace:*",
    "@agentapps/host": "workspace:*",
    "@agentapps/protocol": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "devDependencies": {
    "@agentapps/sdk": "workspace:*"
  }
}
